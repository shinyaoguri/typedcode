{
  "name": "@typedcode/verify-cli",
  "version": "1.0.0",
  "description": "CLI tool to verify TypedCode typing proof files",
  "type": "module",
  "bin": {
    "typedcode-verify": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@typedcode/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typedcode",
    "typing-proof",
    "verification",
    "cli"
  ],
  "license": "MIT"
}
