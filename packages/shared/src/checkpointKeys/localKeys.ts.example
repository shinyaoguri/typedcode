/**
 * ローカル開発用の追加公開鍵 (gitignored)。
 *
 * `localKeys.ts` は git で追跡しない (#338)。無ければ `npm install` (postinstall)・
 * e2e の setup (`npm run setup -w @typedcode/e2e`)・`npm run doctor` がこのファイルから
 * コピーして作る (既にあれば上書きしない)。手で作るなら:
 *   cp localKeys.ts.example localKeys.ts
 *
 * 次に `npm run gen-checkpoint-key -w @typedcode/workers` を実行し、
 * 出力された公開鍵エントリを LOCAL_CHECKPOINT_PUBLIC_KEYS に append する。
 * `registry.ts` の本番鍵リストとマージして使われる。
 *
 * gitignored なので、各開発者の dev 鍵や e2e の使い捨て鍵がコミットされて
 * 本番の verifier に信頼されることはない。本番公開鍵は `registry.ts` に append し、PR でレビューする。
 */

import type { CheckpointPublicKey } from './registry.js';

export const LOCAL_CHECKPOINT_PUBLIC_KEYS: readonly CheckpointPublicKey[] = [
  // 例 (gen-checkpoint-key の出力をそのまま貼る):
  // {
  //   keyId: 'tcp-202605-xxxxxx',
  //   algorithm: 'ECDSA-P256',
  //   publicKeyJwk: { kty: 'EC', crv: 'P-256', x: '...', y: '...' },
  //   status: 'active',
  //   validFrom: '2026-05-28T00:00:00Z',
  //   description: 'My dev key (do not use in production)',
  // },
] as const;
