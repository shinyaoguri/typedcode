      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run doctor:*)",
      "Bash(npm run cf-typegen:*)",
      "Bash(npx biome check:*)",
      "Bash(npx biome ci:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest run:*)",
      "Bash(node scripts/doctor.mjs:*)",
      "Bash(node scripts/dev.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git tag --list:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(git worktree list:*)",
      "Bash(git stash list:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh label list:*)",
      "Bash(gh api repos/shinyaoguri/typedcode/:*)"
